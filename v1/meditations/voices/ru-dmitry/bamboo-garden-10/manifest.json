{
  "id": "bamboo-garden-10",
  "voiceId": "ru-dmitry",
  "edgeVoice": "ru-RU-DmitryNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 685,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.888
    },
    {
      "index": 1,
      "text": "Найдите позу, которая ничего от вас не требует.",
      "file": "c001.ogg",
      "durationSec": 7.272
    },
    {
      "index": 2,
      "text": "Сядьте или лягте с любой поддержкой, которая вам нужна.",
      "file": "c002.ogg",
      "durationSec": 7.776
    },
    {
      "index": 3,
      "text": "Пусть ваши руки будут открытыми или мягкими.",
      "file": "c003.ogg",
      "durationSec": 6.552
    },
    {
      "index": 4,
      "text": "Позвольте глазам закрыться или сохраняйте мягкий взгляд.",
      "file": "c004.ogg",
      "durationSec": 7.56
    },
    {
      "index": 5,
      "text": "Почувствуйте места, где ваше тело встречается с землей.",
      "file": "c005.ogg",
      "durationSec": 7.584
    },
    {
      "index": 6,
      "text": "Пятки, седалищные кости, затылок или длина позвоночника.",
      "file": "c006.ogg",
      "durationSec": 8.592
    },
    {
      "index": 7,
      "text": "Нечего сейчас задерживать.",
      "file": "c007.ogg",
      "durationSec": 4.776
    },
    {
      "index": 8,
      "text": "Сделайте медленный вдох через нос.",
      "file": "c008.ogg",
      "durationSec": 5.52
    },
    {
      "index": 9,
      "text": "Почувствуйте прохладу приходящего воздуха.",
      "file": "c009.ogg",
      "durationSec": 6.168
    },
    {
      "index": 10,
      "text": "И выдохните еще немного.",
      "file": "c010.ogg",
      "durationSec": 4.776
    },
    {
      "index": 11,
      "text": "Почувствуйте, как уходит тепло выдоха.",
      "file": "c011.ogg",
      "durationSec": 6.216
    },
    {
      "index": 12,
      "text": "Снова. Мягкий вдох.",
      "file": "c012.ogg",
      "durationSec": 6.24
    },
    {
      "index": 13,
      "text": "Неторопливый выдох.",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Позвольте плечам немного опуститься.",
      "file": "c014.ogg",
      "durationSec": 5.472
    },
    {
      "index": 15,
      "text": "Позвольте челюсти разжаться.",
      "file": "c015.ogg",
      "durationSec": 4.752
    },
    {
      "index": 16,
      "text": "Пусть живот будет мягким.",
      "file": "c016.ogg",
      "durationSec": 4.728
    },
    {
      "index": 17,
      "text": "Оставайтесь с тремя спокойными вдохами, как есть.",
      "file": "c017.ogg",
      "durationSec": 7.104
    },
    {
      "index": 18,
      "text": "Вдохните. Приезжать.",
      "file": "c018.ogg",
      "durationSec": 6.192
    },
    {
      "index": 19,
      "text": "Выдохните. Решить.",
      "file": "c019.ogg",
      "durationSec": 6.144
    },
    {
      "index": 20,
      "text": "Если ум блуждает, милостиво обратите на это внимание и вернитесь к этому дыханию.",
      "file": "c020.ogg",
      "durationSec": 10.44
    },
    {
      "index": 21,
      "text": "Представьте себе бамбуковый сад после дождя.",
      "file": "c021.ogg",
      "durationSec": 6.12
    },
    {
      "index": 22,
      "text": "Камень темный и чистый. Листья блестят.",
      "file": "c022.ogg",
      "durationSec": 8.088
    },
    {
      "index": 23,
      "text": "Прохладная свежесть наполняет воздух, словно мягкий колокольчик.",
      "file": "c023.ogg",
      "durationSec": 8.352
    },
    {
      "index": 24,
      "text": "Разрыв в облаках пропускает солнце.",
      "file": "c024.ogg",
      "durationSec": 5.808
    },
    {
      "index": 25,
      "text": "Почувствуйте внезапное нежное тепло на лбу и скулах.",
      "file": "c025.ogg",
      "durationSec": 7.248
    },
    {
      "index": 26,
      "text": "Пар слабо поднимается с тропы — земля выдыхает.",
      "file": "c026.ogg",
      "durationSec": 7.128
    },
    {
      "index": 27,
      "text": "Вы ступаете на ступеньки, покрытые мхом.",
      "file": "c027.ogg",
      "durationSec": 6.432
    },
    {
      "index": 28,
      "text": "Каждый камень прохладен и уверен под ногами.",
      "file": "c028.ogg",
      "durationSec": 6.48
    },
    {
      "index": 29,
      "text": "Бамбук скрипит и шепчет на легком ветерке.",
      "file": "c029.ogg",
      "durationSec": 6.816
    },
    {
      "index": 30,
      "text": "Звук зеленый. Звук спокойный.",
      "file": "c030.ogg",
      "durationSec": 7.272
    },
    {
      "index": 31,
      "text": "Почувствуйте запах влажных листьев, камней и легкую сладость чайных растений поблизости.",
      "file": "c031.ogg",
      "durationSec": 10.704
    },
    {
      "index": 32,
      "text": "Остановитесь возле небольшого пруда.",
      "file": "c032.ogg",
      "durationSec": 5.592
    },
    {
      "index": 33,
      "text": "Кои движутся под поверхностью, как медленные мысли.",
      "file": "c033.ogg",
      "durationSec": 7.416
    },
    {
      "index": 34,
      "text": "Солнечные блики согревают ваши запястья, когда вы кладете их на перила.",
      "file": "c034.ogg",
      "durationSec": 9.384
    },
    {
      "index": 35,
      "text": "Ветер охлаждает влажность твоих висков.",
      "file": "c035.ogg",
      "durationSec": 6.192
    },
    {
      "index": 36,
      "text": "Свежесть внутри. Мягкость снаружи.",
      "file": "c036.ogg",
      "durationSec": 7.896
    },
    {
      "index": 37,
      "text": "Следуйте по крытой дорожке из потертого дерева.",
      "file": "c037.ogg",
      "durationSec": 6.816
    },
    {
      "index": 38,
      "text": "Доски прохладные в тени и теплее там, где падает свет.",
      "file": "c038.ogg",
      "durationSec": 8.04
    },
    {
      "index": 39,
      "text": "Вы сидите на скамейке лицом к гравию и идеальному камню.",
      "file": "c039.ogg",
      "durationSec": 7.848
    },
    {
      "index": 40,
      "text": "Ничего не нужно переставлять.",
      "file": "c040.ogg",
      "durationSec": 4.752
    },
    {
      "index": 41,
      "text": "Почувствуйте, как спокойная геометрия успокаивает ваш разум.",
      "file": "c041.ogg",
      "durationSec": 8.352
    },
    {
      "index": 42,
      "text": "Тепло возвращается, когда облака тают, — добрая рука на твоих плечах.",
      "file": "c042.ogg",
      "durationSec": 9.192
    },
    {
      "index": 43,
      "text": "Затем снова заштрихуйте, прохладно и спокойно.",
      "file": "c043.ogg",
      "durationSec": 7.56
    },
    {
      "index": 44,
      "text": "Выпейте воображаемый чай. Вкус тепла. Почувствуйте тепло чашки в ладонях.",
      "file": "c044.ogg",
      "durationSec": 13.584
    },
    {
      "index": 45,
      "text": "За пределами сада жизнь продолжается. Внутри время ослабевает.",
      "file": "c045.ogg",
      "durationSec": 10.704
    },
    {
      "index": 46,
      "text": "Пройдите еще раз под бамбуком.",
      "file": "c046.ogg",
      "durationSec": 4.92
    },
    {
      "index": 47,
      "text": "Позвольте высоким стеблям привести ваше дыхание в тот же легкий ритм.",
      "file": "c047.ogg",
      "durationSec": 8.4
    },
    {
      "index": 48,
      "text": "Прохладная капля с листа попадает на ваше запястье — маленький свежий сюрприз.",
      "file": "c048.ogg",
      "durationSec": 9.648
    },
    {
      "index": 49,
      "text": "Затем снова солнце, грейте то же место, пока оно не высохнет.",
      "file": "c049.ogg",
      "durationSec": 8.688
    },
    {
      "index": 50,
      "text": "Вы принадлежите этому миру до тех пор, пока остаетесь.",
      "file": "c050.ogg",
      "durationSec": 7.968
    },
    {
      "index": 51,
      "text": "И нить этого придет с тобой, когда ты уйдешь.",
      "file": "c051.ogg",
      "durationSec": 6.384
    },
    {
      "index": 52,
      "text": "Посидите еще раз. Руки раскрыты на коленях.",
      "file": "c052.ogg",
      "durationSec": 6.024
    },
    {
      "index": 53,
      "text": "Тепло везде, где касается света. Прохлада в тени бамбука.",
      "file": "c053.ogg",
      "durationSec": 10.152
    },
    {
      "index": 54,
      "text": "Вдохните свежесть после дождя.",
      "file": "c054.ogg",
      "durationSec": 5.28
    },
    {
      "index": 55,
      "text": "Выдохните в неровную тишину камня и гравия.",
      "file": "c055.ogg",
      "durationSec": 7.152
    },
    {
      "index": 56,
      "text": "Ничего острого не осталось. Только мягкие края и достаточно воздуха.",
      "file": "c056.ogg",
      "durationSec": 10.968
    },
    {
      "index": 57,
      "text": "Вернитесь к пруду для последней паузы.",
      "file": "c057.ogg",
      "durationSec": 5.856
    },
    {
      "index": 58,
      "text": "Рябь от упавшей капли расширяется и исчезает.",
      "file": "c058.ogg",
      "durationSec": 7.08
    },
    {
      "index": 59,
      "text": "Солнечные блики танцуют, а затем замирают.",
      "file": "c059.ogg",
      "durationSec": 6.96
    },
    {
      "index": 60,
      "text": "Тепло на скуле. Прохладный туман-память в носу.",
      "file": "c060.ogg",
      "durationSec": 8.592
    },
    {
      "index": 61,
      "text": "Слегка поклонитесь саду — небольшой кивок внутрь.",
      "file": "c061.ogg",
      "durationSec": 7.2
    },
    {
      "index": 62,
      "text": "Пройдите по ступенькам еще раз, медленнее, чем раньше.",
      "file": "c062.ogg",
      "durationSec": 7.608
    },
    {
      "index": 63,
      "text": "Прохладный мох между камнями. Теплая древесина перил моста.",
      "file": "c063.ogg",
      "durationSec": 9.888
    },
    {
      "index": 64,
      "text": "Бамбук говорит над головой на языке листьев.",
      "file": "c064.ogg",
      "durationSec": 6.408
    },
    {
      "index": 65,
      "text": "Ты достаточно это понимаешь: останься, смягчись, продолжай.",
      "file": "c065.ogg",
      "durationSec": 8.568
    },
    {
      "index": 66,
      "text": "На пороге ощущаешь оба мира — покой сада и обычный день.",
      "file": "c066.ogg",
      "durationSec": 8.136
    },
    {
      "index": 67,
      "text": "Вы можете заплести их.",
      "file": "c067.ogg",
      "durationSec": 4.464
    },
    {
      "index": 68,
      "text": "Вдохните свежесть в косу.",
      "file": "c068.ogg",
      "durationSec": 4.8
    },
    {
      "index": 69,
      "text": "Выдохните тепло в руки, готовые встретить то, что придет.",
      "file": "c069.ogg",
      "durationSec": 8.376
    },
    {
      "index": 70,
      "text": "Сад остается, смотрите вы или нет.",
      "file": "c070.ogg",
      "durationSec": 6.48
    },
    {
      "index": 71,
      "text": "Теперь оставьте историю в покое и оставайтесь сенсацией.",
      "file": "c071.ogg",
      "durationSec": 7.56
    },
    {
      "index": 72,
      "text": "Вдохните свежесть этого места.",
      "file": "c072.ogg",
      "durationSec": 5.472
    },
    {
      "index": 73,
      "text": "Вдохните его тепло и тишину.",
      "file": "c073.ogg",
      "durationSec": 5.496
    },
    {
      "index": 74,
      "text": "Вдохните.",
      "file": "c074.ogg",
      "durationSec": 3.264
    },
    {
      "index": 75,
      "text": "Выдохните.",
      "file": "c075.ogg",
      "durationSec": 3.384
    },
    {
      "index": 76,
      "text": "Снова. Мягкий вдох.",
      "file": "c076.ogg",
      "durationSec": 6.24
    },
    {
      "index": 77,
      "text": "Более длинный выдох.",
      "file": "c077.ogg",
      "durationSec": 4.32
    },
    {
      "index": 78,
      "text": "Почувствуйте тело, удерживаемое землей этого воображаемого мира.",
      "file": "c078.ogg",
      "durationSec": 8.952
    },
    {
      "index": 79,
      "text": "Вдохните.",
      "file": "c079.ogg",
      "durationSec": 3.264
    },
    {
      "index": 80,
      "text": "Выдохните.",
      "file": "c080.ogg",
      "durationSec": 3.384
    },
    {
      "index": 81,
      "text": "Если мысли блуждают, вернитесь к теплу на коже.",
      "file": "c081.ogg",
      "durationSec": 7.248
    },
    {
      "index": 82,
      "text": "Или охладить воздух у носа.",
      "file": "c082.ogg",
      "durationSec": 5.064
    },
    {
      "index": 83,
      "text": "Вдохните.",
      "file": "c083.ogg",
      "durationSec": 3.264
    },
    {
      "index": 84,
      "text": "Выдохните.",
      "file": "c084.ogg",
      "durationSec": 3.384
    },
    {
      "index": 85,
      "text": "Вдохните.",
      "file": "c085.ogg",
      "durationSec": 3.264
    },
    {
      "index": 86,
      "text": "Выдохните.",
      "file": "c086.ogg",
      "durationSec": 3.384
    },
    {
      "index": 87,
      "text": "Оставаться. Смягчить. Продолжать.",
      "file": "c087.ogg",
      "durationSec": 9.144
    },
    {
      "index": 88,
      "text": "Вдохните.",
      "file": "c088.ogg",
      "durationSec": 3.264
    },
    {
      "index": 89,
      "text": "Выдохните.",
      "file": "c089.ogg",
      "durationSec": 3.384
    },
    {
      "index": 90,
      "text": "Еще один легкий цикл.",
      "file": "c090.ogg",
      "durationSec": 4.608
    },
    {
      "index": 91,
      "text": "Вдохните.",
      "file": "c091.ogg",
      "durationSec": 3.264
    },
    {
      "index": 92,
      "text": "Выдохните.",
      "file": "c092.ogg",
      "durationSec": 3.384
    },
    {
      "index": 93,
      "text": "Задержитесь в этом чувстве еще на несколько вдохов.",
      "file": "c093.ogg",
      "durationSec": 6.96
    },
    {
      "index": 94,
      "text": "Тепло. Мягкость. Достаточно.",
      "file": "c094.ogg",
      "durationSec": 8.952
    },
    {
      "index": 95,
      "text": "Вы можете вернуться в это место, когда вам это понадобится.",
      "file": "c095.ogg",
      "durationSec": 7.752
    },
    {
      "index": 96,
      "text": "Оно живет в вашем внимании, а не только в воображении.",
      "file": "c096.ogg",
      "durationSec": 7.632
    },
    {
      "index": 97,
      "text": "Начните углублять дыхание.",
      "file": "c097.ogg",
      "durationSec": 5.256
    },
    {
      "index": 98,
      "text": "Снова почувствуйте комнату вокруг себя.",
      "file": "c098.ogg",
      "durationSec": 6.072
    },
    {
      "index": 99,
      "text": "Пошевелите пальцами. Смягчите пальцы ног.",
      "file": "c099.ogg",
      "durationSec": 8.088
    },
    {
      "index": 100,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c100.ogg",
      "durationSec": 6.192
    },
    {
      "index": 101,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c101.ogg",
      "durationSec": 5.448
    },
    {
      "index": 102,
      "text": "Несите это спокойствие во все, что произойдет дальше.",
      "file": "c102.ogg",
      "durationSec": 7.512
    }
  ]
}
