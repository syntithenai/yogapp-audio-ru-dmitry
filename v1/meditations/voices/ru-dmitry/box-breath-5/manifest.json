  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.888
    },
    {
      "index": 1,
      "text": "Найдите удобное сиденье или лягте, если вам так удобнее.",
      "file": "c001.ogg",
      "durationSec": 8.184
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.512
    },
    {
      "index": 3,
      "text": "Смягчите глаза или закройте их.",
      "file": "c003.ogg",
      "durationSec": 5.424
    },
    {
      "index": 4,
      "text": "Сделайте медленный вдох.",
      "file": "c004.ogg",
      "durationSec": 4.608
    },
    {
      "index": 5,
      "text": "И более длинный выдох.",
      "file": "c005.ogg",
      "durationSec": 4.176
    },
    {
      "index": 6,
      "text": "Мы будем дышать в простой коробке.",
      "file": "c006.ogg",
      "durationSec": 5.28
    },
    {
      "index": 7,
      "text": "Всего четыре. Держись четыре. Выход на четверых. Держись четыре.",
      "file": "c007.ogg",
      "durationSec": 15.048
    },
    {
      "index": 8,
      "text": "Оставайся нежным. Никогда не напрягайтесь.",
      "file": "c008.ogg",
      "durationSec": 8.088
    },
    {
      "index": 9,
      "text": "[пауза: 20]",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "Вдохните. Два. Три. Четыре.",
      "file": "c010.ogg",
      "durationSec": 10.776
    },
    {
      "index": 11,
      "text": "Держать. Два. Три. Четыре.",
      "file": "c011.ogg",
      "durationSec": 10.512
    },
    {
      "index": 12,
      "text": "Выдохните. Два. Три. Четыре.",
      "file": "c012.ogg",
      "durationSec": 10.896
    },
    {
      "index": 13,
      "text": "Держать. Два. Три. Четыре.",
      "file": "c013.ogg",
      "durationSec": 10.512
    },
    {
      "index": 14,
      "text": "[пауза: 20]",
      "file": "c014.ogg",
      "durationSec": 4.104
    },
    {
      "index": 15,
      "text": "Снова. Вдохните.",
      "file": "c015.ogg",
      "durationSec": 6.12
    },
    {
      "index": 16,
      "text": "Держать.",
      "file": "c016.ogg",
      "durationSec": 3.0
    },
    {
      "index": 17,
      "text": "Выдохните.",
      "file": "c017.ogg",
      "durationSec": 3.384
    },
    {
      "index": 18,
      "text": "Держать.",
      "file": "c018.ogg",
      "durationSec": 3.0
    },
    {
      "index": 19,
      "text": "[пауза:26]",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "Продолжайте на свой счет еще несколько раундов.",
      "file": "c020.ogg",
      "durationSec": 6.384
    },
    {
      "index": 21,
      "text": "Если четыре слишком долго, используйте три.",
      "file": "c021.ogg",
      "durationSec": 7.08
