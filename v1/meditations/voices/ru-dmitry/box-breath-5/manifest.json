    {
      "index": 22,
      "text": "[пауза: 45]",
      "file": "c022.ogg",
      "durationSec": 4.416
    },
    {
      "index": 23,
      "text": "Еще одна полная коробка.",
      "file": "c023.ogg",
      "durationSec": 4.944
    },
    {
      "index": 24,
      "text": "Вдохните.",
      "file": "c024.ogg",
      "durationSec": 3.264
    },
    {
      "index": 25,
      "text": "Держать.",
      "file": "c025.ogg",
