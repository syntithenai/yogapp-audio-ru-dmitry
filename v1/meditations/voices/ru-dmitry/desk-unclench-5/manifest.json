  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.888
    },
    {
      "index": 1,
      "text": "Оставайтесь сидеть. Это для середины работы.",
      "file": "c001.ogg",
      "durationSec": 8.136
    },
    {
      "index": 2,
      "text": "На мгновение оторвите взгляд от экрана.",
      "file": "c002.ogg",
      "durationSec": 6.048
    },
    {
      "index": 3,
      "text": "Посмотрите подальше, если можете.",
      "file": "c003.ogg",
      "durationSec": 5.568
    },
    {
      "index": 4,
      "text": "[пауза:28]",
      "file": "c004.ogg",
      "durationSec": 4.488
    },
    {
      "index": 5,
      "text": "Поверните плечи вверх, назад и вниз.",
      "file": "c005.ogg",
      "durationSec": 6.192
    },
    {
      "index": 6,
      "text": "Еще дважды.",
      "file": "c006.ogg",
      "durationSec": 3.576
    },
    {
      "index": 7,
      "text": "[пауза:38]",
      "file": "c007.ogg",
      "durationSec": 4.584
    },
    {
      "index": 8,
      "text": "Откройте и закройте руки.",
      "file": "c008.ogg",
      "durationSec": 4.944
    },
    {
      "index": 9,
      "text": "Слегка встряхните их.",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "[пауза:28]",
      "file": "c010.ogg",
      "durationSec": 4.488
    },
    {
      "index": 11,
      "text": "Смягчите бровь.",
      "file": "c011.ogg",
      "durationSec": 3.672
    },
    {
      "index": 12,
      "text": "Разжать челюсть. Дайте языку отдохнуть.",
      "file": "c012.ogg",
      "durationSec": 8.328
    },
    {
      "index": 13,
      "text": "[пауза:38]",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "Вдохните в стороны ребер.",
      "file": "c014.ogg",
      "durationSec": 4.56
    },
    {
      "index": 15,
      "text": "Выдохните и позвольте груди успокоиться.",
      "file": "c015.ogg",
      "durationSec": 6.384
    },
    {
      "index": 16,
      "text": "[пауза:38]",
      "file": "c016.ogg",
      "durationSec": 4.584
    },
    {
      "index": 17,
      "text": "Медленно моргните три раза.",
      "file": "c017.ogg",
      "durationSec": 5.088
    },
    {
      "index": 18,
      "text": "[пауза:28]",
      "file": "c018.ogg",
      "durationSec": 4.488
    },
    {
      "index": 19,
      "text": "Еще один полный вдох.",
      "file": "c019.ogg",
      "durationSec": 4.704
    },
    {
      "index": 20,
      "text": "Возвращайтесь, когда будете готовы, немного менее подготовленными.",
      "file": "c020.ogg",
      "durationSec": 9.288
    },
    {
      "index": 21,
      "text": "[пауза:28]",
      "file": "c021.ogg",
      "durationSec": 4.488
    },
    {
      "index": 22,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c022.ogg",
      "durationSec": 5.448
    },
    {
      "index": 23,
      "text": "Пошевелите пальцами.",
      "file": "c023.ogg",
      "durationSec": 3.864
    },
    {
      "index": 24,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c024.ogg",
      "durationSec": 6.192
    },
    {
      "index": 25,
      "text": "Перенесите легкость обратно к следующей задаче.",
      "file": "c025.ogg",
      "durationSec": 6.696
    }
  ]
