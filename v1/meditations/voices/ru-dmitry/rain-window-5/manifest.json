  "totalSec": 142,
  "chunks": [
    {
      "index": 0,
      "text": "Добро пожаловать.",
      "file": "c000.ogg",
      "durationSec": 3.888
    },
    {
      "index": 1,
      "text": "Найдите удобное сиденье или лягте, если вам так удобнее.",
      "file": "c001.ogg",
      "durationSec": 8.184
    },
    {
      "index": 2,
      "text": "Дайте рукам отдохнуть.",
      "file": "c002.ogg",
      "durationSec": 4.512
    },
    {
      "index": 3,
      "text": "Смягчите глаза или закройте их.",
      "file": "c003.ogg",
      "durationSec": 5.424
    },
    {
      "index": 4,
      "text": "Сделайте медленный вдох.",
      "file": "c004.ogg",
      "durationSec": 4.608
    },
    {
      "index": 5,
      "text": "И более длинный выдох.",
      "file": "c005.ogg",
      "durationSec": 4.176
    },
    {
      "index": 6,
      "text": "Представьте себе, что вы сидите у окна в тихий дождливый день.",
      "file": "c006.ogg",
      "durationSec": 8.064
    },
    {
      "index": 7,
      "text": "Стекло крутое. Мир мягкий снаружи.",
      "file": "c007.ogg",
      "durationSec": 8.088
    },
    {
      "index": 8,
      "text": "[пауза: 30]",
      "file": "c008.ogg",
      "durationSec": 4.056
    },
    {
      "index": 9,
      "text": "Слушайте дождь, не нуждаясь в истории.",
      "file": "c009.ogg",
      "durationSec": 6.096
    },
    {
      "index": 10,
      "text": "Маленькие краны. Иногда тяжелые падения.",
      "file": "c010.ogg",
      "durationSec": 8.664
    },
    {
      "index": 11,
      "text": "[пауза:36]",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "Нюхайте чистый влажный воздух.",
      "file": "c012.ogg",
      "durationSec": 5.16
    },
    {
      "index": 13,
      "text": "Увидеть серый свет, нежный и неторопливый.",
      "file": "c013.ogg",
      "durationSec": 6.72
    },
    {
      "index": 14,
      "text": "[пауза: 30]",
      "file": "c014.ogg",
      "durationSec": 4.056
    },
    {
      "index": 15,
      "text": "В дождь идти некуда.",
      "file": "c015.ogg",
      "durationSec": 4.296
    },
    {
      "index": 16,
      "text": "Разрешение сделать паузу.",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "[пауза:36]",
      "file": "c017.ogg",
      "durationSec": 4.536
    },
    {
      "index": 18,
      "text": "Дышите в ритме воды на стекле.",
      "file": "c018.ogg",
      "durationSec": 5.184
    },
    {
      "index": 19,
      "text": "[пауза: 45]",
      "file": "c019.ogg",
      "durationSec": 4.416
    },
    {
      "index": 20,
      "text": "Позвольте нервной системе принять сигнал: смягчитесь.",
      "file": "c020.ogg",
      "durationSec": 7.368
    },
    {
      "index": 21,
      "text": "[пауза:36]",
      "file": "c021.ogg",
      "durationSec": 4.536
    },
    {
      "index": 22,
      "text": "Сделайте еще один легкий вдох.",
      "file": "c022.ogg",
      "durationSec": 5.448
    },
    {
      "index": 23,
      "text": "Пошевелите пальцами.",
      "file": "c023.ogg",
      "durationSec": 3.864
    },
    {
      "index": 24,
      "text": "Когда будете готовы, откройте глаза.",
      "file": "c024.ogg",
      "durationSec": 6.192
    },
    {
      "index": 25,
      "text": "Носите немного этого с собой.",
      "file": "c025.ogg",
      "durationSec": 5.184
    }
  ]
}
