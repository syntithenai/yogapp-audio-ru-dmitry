  "chunks": [
    {
      "index": 0,
      "text": "Эта практика – на грани сна.",
      "file": "c000.ogg",
      "durationSec": 4.944
    },
    {
      "index": 1,
      "text": "Приглушите свет. Лечь.",
      "file": "c001.ogg",
      "durationSec": 6.168
    },
    {
      "index": 2,
      "text": "В данный момент не осталось ничего, что можно было бы закончить.",
      "file": "c002.ogg",
      "durationSec": 8.136
    },
    {
      "index": 3,
      "text": "[пауза:24]",
      "file": "c003.ogg",
      "durationSec": 4.68
    },
    {
      "index": 4,
      "text": "Мягко вдохните.",
      "file": "c004.ogg",
      "durationSec": 3.768
    },
    {
      "index": 5,
      "text": "Выдыхайте дольше.",
      "file": "c005.ogg",
      "durationSec": 3.864
    },
    {
      "index": 6,
      "text": "[пауза:24]",
      "file": "c006.ogg",
      "durationSec": 4.68
    },
    {
      "index": 7,
      "text": "Освободите лоб.",
      "file": "c007.ogg",
      "durationSec": 3.864
    },
    {
      "index": 8,
      "text": "Отпустите глаза.",
      "file": "c008.ogg",
      "durationSec": 4.008
    },
    {
      "index": 9,
      "text": "Отпустите челюсть.",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "[пауза:29]",
      "file": "c010.ogg",
      "durationSec": 4.56
    },
    {
      "index": 11,
      "text": "Тяжелые руки. Тяжелые ноги.",
      "file": "c011.ogg",
      "durationSec": 6.864
    },
    {
      "index": 12,
      "text": "[пауза:29]",
      "file": "c012.ogg",
      "durationSec": 4.56
    },
    {
      "index": 13,
      "text": "Если мысли посещают, пусть они проносятся мимо, как ночные машины.",
      "file": "c013.ogg",
      "durationSec": 9.432
    },
    {
      "index": 14,
      "text": "Вы остаетесь с дыханием.",
      "file": "c014.ogg",
      "durationSec": 4.872
    },
    {
      "index": 15,
      "text": "[пауза: 45]",
      "file": "c015.ogg",
      "durationSec": 4.416
    },
    {
      "index": 16,
      "text": "Тело тонет.",
      "file": "c016.ogg",
      "durationSec": 3.336
    },
    {
      "index": 17,
      "text": "Дышите спокойно.",
      "file": "c017.ogg",
      "durationSec": 4.008
    },
    {
      "index": 18,
      "text": "[пауза: 45]",
      "file": "c018.ogg",
      "durationSec": 4.416
    },
    {
      "index": 19,
      "text": "Если придет сон, позвольте ему.",
      "file": "c019.ogg",
      "durationSec": 5.712
    },
    {
      "index": 20,
      "text": "Если нет, все равно отдохните.",
